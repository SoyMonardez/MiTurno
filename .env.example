# Base de datos
POSTGRES_USER=miturno
POSTGRES_PASSWORD=miturno
POSTGRES_DB=miturno

# Backend
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email por Gmail (SMTP).
# Dejá SMTP_HOST vacío para modo consola (los emails se imprimen en los logs).
# Para enviar de verdad por Gmail:
#   1) Activá verificación en 2 pasos en tu cuenta.
#   2) Generá una "Contraseña de aplicación" (16 caracteres) y ponela en SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=
SMTP_FROM=MiTurno <tucorreo@gmail.com>
SMTP_TLS=true

# Clave para firmar los tokens de sesión (cambiala por algo random en producción).
SECRET_KEY=cambiar-esta-clave-por-algo-random

# IA (opcional). Groq tiene prioridad. Si ambas están vacías usa lista local de servicios.
# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic (alternativa): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
