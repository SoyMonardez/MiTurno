# Base de datos
POSTGRES_USER=miturno
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=miturno

# Backend
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email. Dejar SMTP_HOST vacío para imprimir correos en los logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=true

# Generar un valor aleatorio distinto en cada entorno.
SECRET_KEY=replace-with-a-random-secret

# Inteligencia artificial (opcional).
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# WhatsApp Gateway (opcional).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
